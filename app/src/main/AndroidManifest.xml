<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="androidx.car.app.MEDIA_TEMPLATES" />

    <!--
      Both services below are exported with no permission requirement on purpose:
      PlaybackService must be bindable by any media browser client (Android Auto,
      Bluetooth, Assistant), and RoadwaveCarAppService must be bindable by any Car
      App Library host. Locking either down with a permission would break exactly
      the discoverability they exist for. Trust is enforced at the app layer
      instead (see RoadwaveCarAppService#createHostValidator).
    -->
    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Roadwave">

        <service
            android:name=".playback.PlaybackService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
            </intent-filter>
        </service>

        <receiver android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@mipmap/ic_launcher" />

        <!--
          Required for Car App Library media apps. Used on media cards and other
          surfaces where media content takes precedence. Must be monochrome.
          A missing attribution icon is one reason a host can reject/filter the app.
        -->
        <meta-data
            android:name="androidx.car.app.TintableAttributionIcon"
            android:resource="@drawable/ic_attribution" />

        <!--
          REQUIRED — do not delete. The car-app AAR supplies no default, and
          AppInfo.retrieveMinCarAppApiLevel() throws IllegalArgumentException when the key
          is absent. That surfaces as a failure response to getAppInfo(), the first call
          of the host handshake, so the app never loads in a car while continuing to work
          perfectly on the phone. (The javadoc on AppInfo.MIN_API_LEVEL_METADATA_KEY
          claims it defaults to CarAppApiLevels.getLatest() when unset; the implementation
          does not agree.)

          Compatibility FLOOR, not a feature switch. It does not select which templates
          this app may use and it does not cap what the host reports.

          AppInfo.create() reads this value as the app's minimum; the maximum is always
          CarAppApiLevels.getLatest() (8, from car-app-api.level in car-app 1.7.0), so the
          legal range here is 1-8. During the handshake, CarAppBinder rejects the host if
          hostApiLevel < this value (or > our max), and CarContext.getCarAppApiLevel()
          then returns the HOST's level, unclamped. So lowering this number only widens
          the set of hosts that will run us — it never changes what we are allowed to send.

          What it therefore is, is a promise: "this app renders correctly on a host at
          this level". Honour it by runtime-gating anything newer, which PlaybackScreen
          does for MediaPlaybackTemplate (@RequiresCarApi(8)) via carAppApiLevel.

          The list screens call ListTemplate.Builder.setHeader(), annotated
          @RequiresCarApi(7), and nothing enforces that annotation at runtime. It
          degrades rather than breaks — setHeader() also populates the legacy mTitle /
          mHeaderAction / mActionStrip fields, so an older host still renders the title
          and back action — but it is the reason this value cannot simply be lowered
          further. Raising it to 7 would be the strictly honest choice and costs nothing
          on any current Android Auto host; it is left at 5 until logHostDiagnostics()
          reports what this car actually negotiates, since raising a floor above the
          host's level makes the app vanish from the car entirely.
        -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="5" />

        <service
            android:name=".playback.RoadwaveCarAppService"
            android:exported="true"
            android:label="@string/app_name"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <action android:name="androidx.car.app.media.action.SHOW_MEDIA_PLAYBACK" />
                <category android:name="androidx.car.app.category.MEDIA" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Roadwave"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>